# Zkopírujte do server/.env. Pouze lokální vývoj; vygenerujte vlastní hodnoty.
# Heslo v DATABASE_URL musí být URL-encoded, nejjednodušší je náhodný hex řetězec.
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://mojeleky:change-this-local-password@localhost:5432/mojeleky
AUTH_SECRET=change-this-to-a-random-secret-of-at-least-32-characters
NODE_ENV=development
PUBLIC_API_URL=http://localhost:3001
APP_WEB_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081
HOST=127.0.0.1
PORT=3001
TRUST_PROXY=false
# Pro fyzický telefon nastavte v Compose 0.0.0.0 a použijte LAN IP i v PUBLIC_API_URL.
API_BIND_ADDRESS=127.0.0.1
# Při spuštění přes npm používá lokální Mailpit, v Compose jej nastavuje služba.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Moje léky <noreply@localhost>
MISSED_DOSE_DELAY_MINUTES=120
# Volitelné podle zabezpečení Expo Push projektu.
EXPO_ACCESS_TOKEN=
